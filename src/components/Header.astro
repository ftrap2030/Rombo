---
import { restaurant } from '../data/restaurant';

const links = [
  { href: '#menu', label: 'Menu' },
  { href: '#gallery', label: 'Gallery' },
  { href: '#visit', label: 'Visit' },
  { href: '#reservations', label: 'Book a table' },
];
---

<header class="header">
  <div class="wrap header__inner">
    <a class="header__brand" href="/">
      {restaurant.name}
      <span class="header__tagline">{restaurant.tagline}</span>
    </a>

    <button
      class="header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="visually-hidden">Menu</span>
      <span class="header__bars" aria-hidden="true"></span>
    </button>

    <nav class="header__nav" id="site-nav" aria-label="Main">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Mobile nav toggle. `hidden` on the nav is driven purely by CSS at desktop
  // widths, so here we only flip the open state and the ARIA attribute.
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const header = document.querySelector<HTMLElement>('.header');

  if (toggle && header) {
    toggle.addEventListener('click', () => {
      const open = header.classList.toggle('header--open');
      toggle.setAttribute('aria-expanded', String(open));
    });

    // Close after tapping a link, otherwise the panel covers the target.
    header.querySelectorAll('.header__nav a').forEach((link) => {
      link.addEventListener('click', () => {
        header.classList.remove('header--open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
  }

  .header__brand {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--ink);
    text-decoration: none;
  }

  .header__tagline {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-top: 0.25rem;
  }

  .header__nav ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__nav a {
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    padding-block: 0.5rem;
    border-bottom: 2px solid transparent;
  }

  .header__nav a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .header__toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    cursor: pointer;
  }

  /* Three-line hamburger drawn from one element plus its pseudo-elements. */
  .header__bars,
  .header__bars::before,
  .header__bars::after {
    display: block;
    width: 1.125rem;
    height: 2px;
    background: var(--ink);
    transition: transform 0.18s ease, opacity 0.18s ease;
  }

  .header__bars::before,
  .header__bars::after {
    content: '';
    position: relative;
  }

  .header__bars::before {
    top: -6px;
  }

  .header__bars::after {
    top: 4px;
  }

  @media (max-width: 46rem) {
    .header__toggle {
      display: flex;
    }

    .header__nav {
      display: none;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      background: var(--bg-raised);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
    }

    .header--open .header__nav {
      display: block;
    }

    .header__nav ul {
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 1.25rem 1.25rem;
    }

    .header__nav li + li {
      border-top: 1px solid var(--line);
    }

    .header__nav a {
      display: block;
      padding: 0.9rem 0;
      border-bottom: none;
    }

    /* Hamburger morphs into a close icon while the panel is open. */
    .header--open .header__bars {
      background: transparent;
    }

    .header--open .header__bars::before {
      top: -2px;
      transform: rotate(45deg);
    }

    .header--open .header__bars::after {
      top: -4px;
      transform: rotate(-45deg);
    }
  }
</style>
