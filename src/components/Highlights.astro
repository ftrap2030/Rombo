---
import { googleRating, amenities } from '../data/restaurant';
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang);
---

<section class="highlights" aria-label={copy.ratingLabel}>
  <div class="wrap highlights__inner">
    {googleRating && (
      {/*
        The visible value and count are separate boxes, which a screen reader
        would otherwise run together as "4.7371". This label reads it properly.
      */}
      <a
        class="rating"
        href={googleRating.url}
        rel="noopener noreferrer"
        target="_blank"
        aria-label={`${googleRating.value} ${copy.ratingOutOfFive} · ${googleRating.count} ${copy.ratingOnGoogle}`}
      >
        <svg class="rating__star" viewBox="0 0 20 20" aria-hidden="true">
          <path
            fill="currentColor"
            d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"
          />
        </svg>
        <span class="rating__value">{googleRating.value}</span>
        <span class="rating__count">
          {googleRating.count} {copy.ratingOnGoogle}
        </span>
      </a>
    )}

    <ul class="amenities">
      {amenities.map((amenity) => (
        <li class="amenity">{amenity[lang]}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .highlights {
    background: var(--bg-raised);
    border-bottom: 1px solid var(--line);
  }

  .highlights__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    padding-block: 1rem;
  }

  .rating {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
  }

  .rating__star {
    width: 1rem;
    height: 1rem;
    color: #e0a12a;
    /* Baseline alignment nudge: the glyph box sits a little high. */
    align-self: center;
  }

  .rating__value {
    font-weight: 700;
    font-size: 1.0625rem;
    font-variant-numeric: tabular-nums;
  }

  .rating__count {
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .rating:hover .rating__count {
    color: var(--accent);
    text-decoration: underline;
  }

  .amenities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .amenity {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-muted);
    background: var(--bg-inset);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
  }
</style>
