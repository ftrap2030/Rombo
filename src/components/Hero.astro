---
import { restaurant } from '../data/restaurant';
---

<section class="hero">
  <div class="wrap hero__inner">
    <p class="eyebrow">{restaurant.tagline}</p>
    <h1>{restaurant.name}</h1>
    <p class="hero__intro">{restaurant.intro}</p>

    <div class="hero__actions">
      <a class="button" href="#reservations">Book a table</a>
      <a class="button button--ghost" href="#menu">See the menu</a>
    </div>
  </div>
</section>

<style>
  .hero {
    /* Replace this gradient with a real photo once one is available:
       background: url('/images/hero.jpg') center / cover no-repeat; */
    background:
      radial-gradient(
        ellipse at 20% 0%,
        color-mix(in srgb, var(--accent) 12%, transparent),
        transparent 60%
      ),
      var(--bg-inset);
    border-bottom: 1px solid var(--line);
  }

  .hero__inner {
    padding-block: clamp(4rem, 12vw, 8rem);
    max-width: 40rem;
  }

  .hero__intro {
    font-size: clamp(1.0625rem, 2.2vw, 1.25rem);
    color: var(--ink-muted);
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
