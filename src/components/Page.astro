---
/**
 * The homepage in a given language. Both `/` (Spanish) and `/en/` (English)
 * render this with a different `lang`, so the two versions can never drift
 * apart structurally.
 */
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import Highlights from './Highlights.astro';
import About from './About.astro';
import Menu from './Menu.astro';
import Gallery from './Gallery.astro';
import Visit from './Visit.astro';
import Reservations from './Reservations.astro';
import type { Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<Layout lang={lang}>
  <Hero lang={lang} />
  <Highlights lang={lang} />
  <About lang={lang} />
  <Menu lang={lang} />
  <Gallery lang={lang} />
  <Visit lang={lang} />
  <Reservations lang={lang} />
</Layout>
