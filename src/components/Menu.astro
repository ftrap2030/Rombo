---
import { menu } from '../data/restaurant';
import type { Locale } from '../i18n';
import { t, tagNames } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang);
const tags = tagNames[lang];
---

<section class="section" id="menu">
  <div class="wrap">
    <div class="section__intro">
      <p class="eyebrow">{copy.menuEyebrow}</p>
      <h2>{copy.menuTitle}</h2>
      <p>{copy.menuIntro}</p>
    </div>

    <div class="menu">
      {menu.map((section) => (
        <section class="menu__section">
          <h3 class="menu__heading">{section.title[lang]}</h3>
          {section.description && (
            <p class="menu__blurb">{section.description[lang]}</p>
          )}

          <ul class="menu__list">
            {section.items.map((item) => (
              <li class="item">
                <div class="item__head">
                  <h4 class="item__name">{item.name}</h4>
                  {/* The dotted leader and price only appear once a price is set. */}
                  {item.price && (
                    <>
                      <span class="item__dots" aria-hidden="true"></span>
                      <span class="item__price">{item.price}</span>
                    </>
                  )}
                </div>
                <p class="item__description">{item.description[lang]}</p>
                {item.tags && item.tags.length > 0 && (
                  <ul class="item__tags">
                    {item.tags.map((tag) => (
                      <li class="tag">{tags[tag]}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .menu {
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
  }

  @media (min-width: 52rem) {
    .menu {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 4rem;
    }
  }

  .menu__heading {
    font-size: 1.375rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--accent);
    margin-bottom: 0.75rem;
  }

  .menu__blurb {
    color: var(--ink-muted);
    font-size: 0.9375rem;
    font-style: italic;
    margin-bottom: 1.25rem;
  }

  .menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  /* Name and price on one line, joined by a dotted leader that absorbs the
     leftover space — the classic printed-menu look. */
  .item__head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .item__name {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
  }

  .item__dots {
    flex: 1;
    border-bottom: 1px dotted var(--line);
    transform: translateY(-0.2em);
  }

  .item__price {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .item__description {
    color: var(--ink-muted);
    font-size: 0.9375rem;
    margin: 0.25rem 0 0;
  }

  .item__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
  }

  .tag {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    background: var(--bg-inset);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }
</style>
